LLM_PROVIDER=groq
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-20b

OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

TAVILY_API_KEY=your_tavily_key

SEMANTIC_CACHE_THRESHOLD=0.55
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# simple works without system libraries; use weasyprint after installing its native dependencies.
PDF_RENDERER=simple

# Authentication and persistent database
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_MINUTES=10080
DATABASE_URL=sqlite:///data/research_agent.sqlite3
